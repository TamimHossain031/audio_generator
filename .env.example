# GEMINI_API_KEY: Primary key for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_API_KEYS: Optional comma-separated pool of Google API keys for automatic quota rotation.
# When one key reaches Free Tier rate limits (429), the engine rotates to the next key.
# Example: "AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3..."
GOOGLE_API_KEYS=""

# ELEVENLABS_API_KEY: Optional ElevenLabs API key for multilingual voiceover synthesis.
# Users can also configure this directly in the app's API Keys settings.
ELEVENLABS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

